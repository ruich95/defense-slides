    },
    {
      "id": 6,
      "left": 91,
      "top": 175,
      "width": 1419,
      "height": 90,
      "scale": 1,
      "visible": true,
      "html": "The function <code>run</code> lifts single-step behaviour to a sequence of reactions.",
      "role": "explanation"
    },
    {
      "id": 11,
      "left": 91,
      "top": 650,
      "width": 1419,
      "height": 90,
      "scale": 1,
      "visible": false,
      "html": "With <strong>one input consumed per iteration</strong>, the lifting gives the Mealy-machine behaviour of <code>f</code> and initial state <code>st</code>.",
      "role": "explanation"
    },
    {
      "id": 14,
      "left": 91,
      "top": 754,
      "width": 1419,
      "height": 90,
      "scale": 1,
      "visible": false,
      "html": "We can define composition through <strong>single-step components</strong> and justify its behaviour through <code>run</code>.",
      "role": "explanation"
    }
  ]
